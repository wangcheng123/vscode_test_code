{
  "name": "ant-icon-helper",
  "displayName": "ant icon Helper",
  "version": "1.0.1",
  "publisher": "chengwang",
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "vscode",
    "extension",
    "ant",
    "icon",
    "antd",
    "antd icon"
  ],
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ant-icon-helper.addImport",
        "title": "Add Ant Icon Import"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangcheng123/vscode_test_code.git"
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
