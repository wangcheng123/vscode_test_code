{
  "name": "ant-icon-helper",
  "displayName": "Ant Icon Helper",
  "version": "0.0.2",
  "publisher": "chengwang",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
   "icon": "images/icon.png",

  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ant-icon-helper.addImport",
        "title": "Add Ant Icon Import"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}